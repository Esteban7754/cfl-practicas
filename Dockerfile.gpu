# Variante con GPU NVIDIA (opcional, no probada en este equipo).
# Requiere Docker Desktop con WSL2 y el controlador NVIDIA actualizado.
#   docker build -f Dockerfile.gpu -t cfl-practicas-gpu .
#   docker run --rm --gpus all -v "${PWD}:/workspace" -v cfl-hf-cache:/cache/huggingface cfl-practicas-gpu python cifar100_three_buffer.py ...
# Las mismas versiones que requirements.lock, pero con las ruedas CUDA de PyPI.
FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b

ENV PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    HF_HOME=/cache/huggingface \
    PYTHONPATH=/workspace

WORKDIR /workspace

COPY requirements.lock /tmp/requirements.lock
RUN sed -e '/^--extra-index-url/d' -e 's/+cpu//' /tmp/requirements.lock > /tmp/requirements-gpu.txt \
    && python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir -r /tmp/requirements-gpu.txt

CMD ["python"]
